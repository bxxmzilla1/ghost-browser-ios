<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Any spoofed app may apply this profile; it only ever grants access to Heavenzy's own
	     directory, so a wildcard is safe. -->
	<key>AllowedProcesses</key>
	<array>
		<string>*</string>
	</array>
	<!-- Read-write access to the shared Heavenzy dir (apps.plist, springboard.plist, and the
	     Containers snapshot store) from inside a sandboxed app. -->
	<key>Extensions</key>
	<array>
		<dict>
			<key>type</key>
			<string>file</string>
			<key>extension_class</key>
			<string>com.apple.app-sandbox.read-write</string>
			<key>path</key>
			<string>/var/mobile/Library/Preferences/Heavenzy</string>
		</dict>
	</array>
</dict>
</plist>
